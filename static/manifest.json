{
  "manifest_version": 3,
  "name": "Facebook Helper",
  "version": "1.6.0",
  "description": "Download photos and manage your own comments on Facebook.",
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*.facebook.com/*"],
      "js": ["comment-scanner.js", "photo-picker.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["alarms", "downloads", "offscreen", "scripting", "storage", "tabs"],
  "host_permissions": [
    "https://*.facebook.com/*",
    "https://*.fbcdn.net/*"
  ]
}
